<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.PasswordField?>

<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="8.0"
      xmlns="http://javafx.com/javafx/17.0.12" fx:controller="library.controllers.MyProfileController">
	<GridPane maxHeight="-Infinity" maxWidth="-Infinity">
		<columnConstraints>
			<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
			<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
		</columnConstraints>
		<rowConstraints>
			<RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
			<RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
			<RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
		</rowConstraints>
		<VBox.margin>
			<Insets/>
		</VBox.margin>
		<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Username:"/>
		<Text strokeType="OUTSIDE" strokeWidth="0.0" text="New Name:" GridPane.rowIndex="1"/>
		<Text strokeType="OUTSIDE" strokeWidth="0.0" text="New Password:" GridPane.rowIndex="2"/>
		<TextField fx:id="newNameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
		<PasswordField fx:id="newPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
		<Text fx:id="usernameText" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" GridPane.columnIndex="1"/>
	</GridPane>
	<Button onAction="#updateProfile" mnemonicParsing="false" text="Update"/>
</VBox>

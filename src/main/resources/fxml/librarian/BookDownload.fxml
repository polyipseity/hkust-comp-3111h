<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="library.controllers.librarian.BookDownloadController"
            prefHeight="400.0" prefWidth="600.0">
	<VBox AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.bottomAnchor="0">
		<!-- Search Bar Section -->
		<HBox>
			<padding>
				<Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
			</padding>
			<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Search:">
				<HBox.margin>
					<Insets top="8.0"/>
				</HBox.margin>
			</Text>
			<TextField fx:id="searchBar" HBox.hgrow="ALWAYS">
				<HBox.margin>
					<Insets left="8.0"/>
				</HBox.margin>
			</TextField>
			<Button onAction="#searchBooks" text="Search">
				<HBox.margin>
					<Insets left="8.0"/>
				</HBox.margin>
			</Button>
		</HBox>
		<SplitPane dividerPositions="0.75" VBox.vgrow="ALWAYS">
			<TableView minWidth="200.0" fx:id="table">
				<columns>
				<!--suppress XmlUnresolvedReference -->
				<TableColumn fx:id="titleCol" prefWidth="${table.width * 0.30}" text="Title"/>
				<!--suppress XmlUnresolvedReference -->
				<TableColumn fx:id="authorCol" prefWidth="${table.width * 0.15}" text="Author"/>
				<!--suppress XmlUnresolvedReference -->
				<TableColumn fx:id="bookshelvesCol" prefWidth="${table.width * 0.15}" text="Bookshelves"/>
				<!--suppress XmlUnresolvedReference -->
				<TableColumn fx:id="summaryCol" prefWidth="${table.width * 0.40}" text="Summary"/>
				</columns>
			</TableView>
			<ScrollPane minWidth="200.0" fitToWidth="true" fx:id="sidebar">
				<VBox>
					<padding>
						<Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
					</padding>
					<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Selected Book">
						<font>
							<Font name="System Bold" size="14.0"/>
						</font>
						<VBox.margin>
							<Insets bottom="8.0"/>
						</VBox.margin>
					</Text>
					<Button onAction="#downloadSelected" text="Download Selected" wrapText="true">
						<VBox.margin>
							<Insets bottom="8.0"/>
						</VBox.margin>
					</Button>
					<Separator>
						<VBox.margin>
							<Insets bottom="16.0"/>
						</VBox.margin>
					</Separator>
					<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Title:">
						<font>
							<Font name="System Bold" size="12.0"/>
						</font>
					</Text>
					<!--suppress XmlUnresolvedReference -->
					<Text fx:id="titleText" strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="${sidebar.width - 36}"/>
					<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Author:">
						<VBox.margin>
							<Insets top="16.0"/>
						</VBox.margin>
						<font>
							<Font name="System Bold" size="12.0"/>
						</font>
					</Text>
					<!--suppress XmlUnresolvedReference -->
					<Text fx:id="authorText" strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="${sidebar.width - 36}"/>
					<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Bookshelves:">
						<VBox.margin>
							<Insets top="16.0"/>
						</VBox.margin>
						<font>
							<Font name="System Bold" size="12.0"/>
						</font>
					</Text>
					<!--suppress XmlUnresolvedReference -->
					<Text fx:id="bookshelvesText" strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="${sidebar.width - 36}"/>
					<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Summary:">
						<VBox.margin>
							<Insets top="16.0"/>
						</VBox.margin>
						<font>
							<Font name="System Bold" size="12.0"/>
						</font>
					</Text>
					<!--suppress XmlUnresolvedReference -->
					<Text fx:id="summaryText" strokeType="OUTSIDE" strokeWidth="0.0" wrappingWidth="${sidebar.width - 36}"
					      textAlignment="JUSTIFY"/>
				</VBox>
			</ScrollPane>
		</SplitPane>
	</VBox>
</AnchorPane>

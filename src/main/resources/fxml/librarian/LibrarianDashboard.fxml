<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" prefHeight="600" prefWidth="900"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="library.controllers.librarian.LibrarianDashboardController">

	<!-- Top header + Logout -->
	<top>
		<Label style="-fx-font-size:24px; -fx-padding:10" text="Librarian Dashboard" BorderPane.alignment="CENTER"/>
	</top>

	<!-- Main tabs -->
	<center>
		<TabPane tabClosingPolicy="UNAVAILABLE">

			<!-- 1) Pending Approvals -->
			<Tab text="Pending Approvals">
				<StackPane>
					<fx:include source="PendingApprovals.fxml"/>
				</StackPane>
			</Tab>

			<!-- 2) Manage Users -->
			<Tab text="Manage Users">
				<StackPane>
					<fx:include source="ManageUsers.fxml"/>
				</StackPane>
			</Tab>

			<!-- 3) My Profile -->
			<Tab text="My Profile">
				<StackPane>
					<fx:include source="../common/MyProfile.fxml"/>
				</StackPane>
			</Tab>

			<!-- 4) Borrowed Books Report -->
			<Tab text="Borrowed Books">
				<StackPane>
					<fx:include source="BorrowedBooks.fxml"/>
				</StackPane>
			</Tab>

			<!-- 5) Published Books Report -->
			<Tab text="Published Books">
				<StackPane>
					<fx:include source="PublishedBooks.fxml"/>
				</StackPane>
			</Tab>

			<!-- 6) Book Requests -->
			<Tab text="Book Requests">
				<StackPane>
					<fx:include source="BookRequests.fxml"/>
				</StackPane>
			</Tab>

			<!-- 7) Book Download -->
			<Tab text="Book Download">
				<StackPane>
					<fx:include source="BookDownload.fxml"/>
				</StackPane>
			</Tab>

		</TabPane>
	</center>

	<bottom>
		<HBox alignment="CENTER" spacing="20">
			<padding>
				<Insets bottom="10" left="10" right="10" top="10"/>
			</padding>
			<Button onAction="#goToLogout" prefHeight="40" prefWidth="150" text="Logout"/>
		</HBox>
	</bottom>
</BorderPane>

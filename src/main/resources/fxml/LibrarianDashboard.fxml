<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.controllers.LibrarianDashboardController">

    <!-- Top header + Logout -->
    <top>
        <Label style="-fx-font-size:24px; -fx-padding:10" text="Librarian Dashboard" BorderPane.alignment="CENTER" />
    </top>

    <!-- Main tabs -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- 1) Pending Approvals -->
            <Tab text="Pending Approvals">
            </Tab>

            <!-- 2) Manage Users -->
            <Tab text="Manage Users">
            </Tab>

            <!-- 3) My Profile -->
            <Tab text="My Profile">
            </Tab>

            <!-- 4) Borrowed Books Report -->
            <Tab text="Borrowed Books">
            </Tab>

            <!-- 5) Published Books Report -->
            <Tab text="Published Books">
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleLogout" prefHeight="40" prefWidth="150" text="Logout" />
        </HBox>
    </bottom>
</BorderPane>

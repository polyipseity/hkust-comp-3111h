<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>


<VBox alignment="CENTER_LEFT" spacing="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
fx:controller="library.controllers.author.ModifyWindowController">
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Edit fields you want to change">
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </VBox.margin>
      </Text>
      <Separator prefWidth="200.0" />
      <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="264.39996337890625" minWidth="10.0" prefWidth="62.39998779296875" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="486.0" minWidth="10.0" prefWidth="384.00001220703126" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="34.599981689453124" minHeight="10.0" prefHeight="20.19998779296875" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="202.80000000000004" minHeight="10.0" prefHeight="121.00001220703126" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="96.60001220703128" minHeight="0.0" prefHeight="20.199987792968756" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Title:" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Summary:" GridPane.rowIndex="1" />
            <TextArea wrapText="true" fx:id="SummaryArea" prefHeight="200.0" prefWidth="394.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="TitleField" GridPane.columnIndex="1" />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <children>
                  <Button onAction="#cancelModification" mnemonicParsing="false" prefWidth="60.0" text="Cancel" />
                  <Button onAction="#saveModification" fx:id="saveButton" defaultButton="true" disable="true" mnemonicParsing="false" prefWidth="60.0" text="Save" />
               </children>
               <GridPane.margin>
                  <Insets top="15.0" />
               </GridPane.margin>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </GridPane>
   </children>
   <padding>
      <Insets bottom="10.0" top="10.0" />
   </padding>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="library.controllers.author.AuthorMyBooksController">
   <children>
      <TableView VBox.vgrow="ALWAYS" fx:id="BooksTable">
         <columns>
            <TableColumn fx:id="Title" prefWidth="${BooksTable.width*0.25}" text="Title" />
            <TableColumn fx:id="Status" prefWidth="${BooksTable.width*0.1}" text="Status" />
            <TableColumn fx:id="Date" prefWidth="${BooksTable.width*0.1}" text="Publish Date" />
            <TableColumn fx:id="Readers" prefWidth="${BooksTable.width*0.1}" text="Readers" />
            <TableColumn fx:id="Abstract" prefWidth="${BooksTable.width*0.45}" text="Abstract" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </TableView>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
         <children>
             <Button onAction="#refresh" mnemonicParsing="false" text="Refresh" textAlignment="CENTER"/>
            <Button onAction="#AuthorViewBook" mnemonicParsing="false" text="View" textAlignment="CENTER"/>
            <Button onAction="#AuthorModifyBook" mnemonicParsing="false" text="Modify" textAlignment="CENTER"/>
            <Button onAction="#AuthorDeleteBook" mnemonicParsing="false" text="Delete" textAlignment="CENTER" />
         </children>
          <padding>
              <Insets top="10.0" />
          </padding>
      </HBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="15.0" right="15.0" top="40.0" />
   </padding>
</VBox>

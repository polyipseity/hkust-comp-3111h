<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" prefHeight="400.0" prefWidth="600.0"
      spacing="40.0" xmlns="http://javafx.com/javafx/25"
      fx:controller="library.controllers.author.StatusViewController">
	<padding>
		<Insets bottom="50.0" left="50.0" right="50.0" top="50.0"/>
	</padding>
	<HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0" VBox.vgrow="ALWAYS">
		<PieChart maxWidth="500" maxHeight="500" fx:id="statusChart" title="My Books: Status"
		          HBox.hgrow="ALWAYS"/>
		<BarChart legendVisible="false" maxWidth="500" maxHeight="500" animated="false" fx:id="popularChart"
		          title="Top 5 Most Popular Book" HBox.hgrow="ALWAYS">
			<xAxis>
				<CategoryAxis side="BOTTOM" tickLabelRotation="90"/>
			</xAxis>
			<yAxis>
				<NumberAxis tickUnit="10.0" minorTickCount="0"
				            label="Times Borrowed" side="LEFT"/>
			</yAxis>
		</BarChart>
	</HBox>
	<!--suppress JavaFxEventHandler -->
	<Button minHeight="40.0" mnemonicParsing="false" onAction="#loadData" text="Refresh Status" VBox.vgrow="NEVER"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<Pane focusTraversable="true" maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity" mouseTransparent="true" xmlns="http://javafx.com/javafx/25">
	<HBox prefHeight="50.0" prefWidth="500.0">
		<HBox alignment="CENTER_LEFT" prefHeight="100.0" HBox.hgrow="ALWAYS">
			<HBox.margin>
				<Insets left="10.0"/>
			</HBox.margin>
			<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Notification"/>
		</HBox>
		<HBox alignment="CENTER_RIGHT">
			<HBox.margin>
				<Insets left="10.0" right="10.0"/>
			</HBox.margin>
			<Button defaultButton="true" mnemonicParsing="false" text="Clear"/>
		</HBox>
	</HBox>
</Pane>

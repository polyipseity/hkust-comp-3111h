<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="8.0"
      xmlns="http://javafx.com/javafx/17.0.12" fx:controller="library.controllers.student_staff.RequestBookController">
	<GridPane maxHeight="-Infinity" maxWidth="-Infinity">
		<columnConstraints>
			<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
			<ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
		</columnConstraints>
		<rowConstraints>
			<RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
			<RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
		</rowConstraints>
		<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Book Title:"/>
		<Text strokeType="OUTSIDE" strokeWidth="0.0" text="Book Author:" GridPane.rowIndex="1"/>
		<TextField GridPane.columnIndex="1"/>
		<TextField GridPane.columnIndex="1" GridPane.rowIndex="1"/>
	</GridPane>
	<Button mnemonicParsing="false" text="Submit Request"/>
</VBox>
